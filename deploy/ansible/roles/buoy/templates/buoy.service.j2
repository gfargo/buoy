{{ ansible_managed | comment }}
[Unit]
Description=Buoy — per-node system dashboard
Documentation=https://github.com/gfargo/buoy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ buoy_venv_dir }}/bin/buoy --config {{ buoy_config_dir }}/buoy.yaml
WorkingDirectory={{ buoy_data_dir }}
User={{ buoy_user }}
Group={{ buoy_group }}
Restart=on-failure
RestartSec=5

EnvironmentFile=-{{ buoy_config_dir }}/buoy.env

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ buoy_data_dir }}
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
